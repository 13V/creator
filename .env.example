# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# A public RPC will rate-limit you almost immediately. Use Helius/Triton/QuickNode.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_CLUSTER="mainnet-beta"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"

# ---------------------------------------------------------------------------
# X (Twitter) API  -- STRONGLY RECOMMENDED
# ---------------------------------------------------------------------------
# Without this, X launches cannot resolve a numeric user id, so they fall back
# to a custodial managed escrow instead of pump.fun's native, non-custodial
# social fee vault. See README "Escrow strategies".
X_BEARER_TOKEN=""

# ---------------------------------------------------------------------------
# Managed escrow (Instagram / TikTok)
# ---------------------------------------------------------------------------
# 32+ bytes of entropy, hex or base64:  openssl rand -hex 32
# Back this up offline. Losing it forfeits every unclaimed managed escrow.
# In production this belongs in a KMS/HSM, not an env var.
ESCROW_MASTER_SEED=""

# Guards POST /api/claim/payout.  openssl rand -hex 24
ADMIN_TOKEN=""

# ---------------------------------------------------------------------------
# Launchpad economics (optional)
# ---------------------------------------------------------------------------
PLATFORM_FEE_WALLET=""
PLATFORM_FEE_LAMPORTS="0"

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATABASE_PATH="./data/launchpad.db"

# Absolute base URL, so share-card image links resolve.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
