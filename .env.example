# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# A public RPC will rate-limit you almost immediately. Use Helius/Triton/QuickNode.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_CLUSTER="mainnet-beta"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"

# ---------------------------------------------------------------------------
# X (Twitter) API  -- STRONGLY RECOMMENDED
# ---------------------------------------------------------------------------
# Without this, X launches cannot resolve a numeric user id, so they fall back
# to a custodial managed escrow instead of pump.fun's native, non-custodial
# social fee vault. See README "Escrow strategies".
X_BEARER_TOKEN=""

# ---------------------------------------------------------------------------
# Managed escrow (Instagram / TikTok)
# ---------------------------------------------------------------------------
# 32+ bytes of entropy, hex or base64:  openssl rand -hex 32
# Back this up offline. Losing it forfeits every unclaimed managed escrow.
# In production this belongs in a KMS/HSM, not an env var.
ESCROW_MASTER_SEED=""

# Guards POST /api/claim/payout.  openssl rand -hex 24
ADMIN_TOKEN=""

# ---------------------------------------------------------------------------
# Address lookup table  -- REQUIRED for launches with an opening buy
# ---------------------------------------------------------------------------
# A create-plus-buy transaction references ~26 accounts and lands just over
# Solana's 1232-byte limit without a lookup table, so those launches fail.
# Create one once with:  npm run setup:lookup-table
PUMP_LOOKUP_TABLE=""

# ---------------------------------------------------------------------------
# Launchpad economics (optional)
# ---------------------------------------------------------------------------
PLATFORM_FEE_WALLET=""
# The platform's cut of creator fees, in basis points. 1000 = 10%, leaving the
# creator 90%. Enforced on-chain by a pump.fun fee-sharing config, so neither
# side has to trust the other. Coins on a pump.fun social vault always pay the
# creator 100% — nobody can sign as their creator to set a split.
PLATFORM_FEE_SHARE_BPS="1000"

# SOL the launch sends to the creator's escrow so it can pay rent for that
# config. The escrow has earned nothing at launch and the config is created in
# its name.
FEE_SHARE_RENT_LAMPORTS="12000000"

PLATFORM_FEE_LAMPORTS="0"

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# REQUIRED on Vercel, Netlify, Lambda, or anything else serverless: those hosts
# give each invocation a read-only filesystem outside /tmp, and /tmp is wiped
# when the function ends, so the SQLite fallback cannot persist anything there.
# Any hosted Postgres works (Neon, Supabase, Vercel Postgres, RDS).
DATABASE_URL=""

# Used only when DATABASE_URL is unset — the zero-setup local default.
DATABASE_PATH="./data/launchpad.db"

# Absolute base URL, so share-card image links resolve.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
