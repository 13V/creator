{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/env.ts",
    "src/lib/social/parse.ts",
    "src/lib/social/types.ts",
    "src/lib/escrow/derive.ts",
    "src/lib/pump/payoutTx.ts",
    "src/lib/base64.ts",
    "src/lib/siteUrl.ts",
    "test/**/*.ts",
    "src/lib/pump/feeShare.ts"
  ]
}
